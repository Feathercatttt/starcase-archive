{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starcase.local/schema/package-v1.json",
  "title": "Starcase Archive Package v1",
  "type": "object",
  "required": [
    "format",
    "packageVersion",
    "data"
  ],
  "properties": {
    "format": {
      "const": "starcase-archive"
    },
    "packageVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "workspace",
        "collection"
      ]
    },
    "exportedAt": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "app",
        "schemaVersion",
        "entries",
        "projects",
        "media"
      ],
      "properties": {
        "app": {
          "const": "starcase-archive"
        },
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,120}$"
        },
        "title": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "system"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,120}$"
              },
              "name": {
                "type": "string"
              },
              "system": {
                "enum": [
                  "dnd",
                  "coc",
                  "any"
                ]
              }
            }
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "dataUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,120}$"
              },
              "name": {
                "type": "string"
              },
              "mime": {
                "type": "string"
              },
              "dataUrl": {
                "type": "string",
                "pattern": "^data:image/(png|jpeg|webp|gif);base64,"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
